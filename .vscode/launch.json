{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🌳 Debug ANTLR4 (Visual)",
            "type": "antlr-debug",
            "request": "launch",
            "grammar": "${workspaceFolder}/src/main/antlr4/com/compilador/MiniLenguaje.g4",
            // CORRECCIÓN: Ruta exacta a tu archivo .txt nuevo
            "input": "${workspaceFolder}/src/main/input/input.txt",
            "startRule": "programa",
            "printParseTree": true,
            "visualParseTree": true
        },
        {
            "type": "java",
            "name": "🚀 Correr Compilador (App)",
            "request": "launch",
            "mainClass": "com.compilador.App",
            "projectName": "demo",
            "cwd": "${workspaceFolder}" 
        }
    ]
}